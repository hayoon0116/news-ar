https://leaves-toilet-travis-love.trycloudflare.com    https://leaves-toilet-travis-love.trycloudflare.com    https://leaves-toilet-travis-love.trycloudflare.com    https://leaves-toilet-travis-love.trycloudflare.com    https://leaves-toilet-travis-love.trycloudflare.com    <!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEWS AR</title>

<script src="https://aframe.io/releases/1.4.2/aframe.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

<style>
body {
    margin: 0;
    overflow: hidden;
}

#guide {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999;
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 12px 20px;
    border-radius: 30px;
    font-family: Arial, sans-serif;
}
</style>
</head>

<body>

<div id="guide">📰 뉴스 스크랩을 비춰보세요</div>

<a-scene
    mindar-image="
        imageTargetSrc: ./targets.mind;
        autoStart: true;
        uiScanning: true;
        uiLoading: true;
    "
    color-space="sRGB"
    renderer="colorManagement: true"
    vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false">

    <a-assets>
        <video
            id="newsVideo"
            src="./news.mp4"
            playsinline
            webkit-playsinline
            muted
            autoplay
            loop>
        </video>
    </a-assets>

    <a-camera
        position="0 0 0"
        look-controls="enabled: false">
    </a-camera>

    <a-entity mindar-image-target="targetIndex: 0">

        <a-video
            id="arVideo"
            src="#newsVideo"
            position="0 0 0"
            width="1"
            height="0.5625">
        </a-video>

    </a-entity>

</a-scene>

<script>

const target = document.querySelector('[mindar-image-target]');
const guide = document.getElementById('guide');
const video = document.getElementById('newsVideo');
const arVideo = document.getElementById('arVideo');

target.addEventListener('targetFound', () => {
    guide.innerHTML = '🎥 기사를 찾았습니다!';
    video.play().catch(() => {});
});

target.addEventListener('targetLost', () => {
    guide.innerHTML = '📰 뉴스 스크랩을 비춰보세요';
    video.pause();
});

arVideo.addEventListener('click', function () {
    if (video.paused) {
        video.play();
    } else {
        video.pause();
    }
});    if (video.paused) {
        video.play();
    } else {
        video.pause();
    }
});

</script>

</body>
</html>
